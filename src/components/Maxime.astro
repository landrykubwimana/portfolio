---
/**
 * MAXIME — la respiration avant le pied de page.
 *
 * Trois éléments repris de la page « À propos » d'aeeureka, dans le même
 * ordre : le méandre grec qui annonce le changement de registre, la couronne
 * de laurier, puis la citation avec son auteur et sa source.
 */
import { profile } from '../data/profile';

const { maxim } = profile;
---

<section class="section maxime-band">
  <div class="wrap">
    <div class="meandre" aria-hidden="true"></div>

    <figure class="maxime">
      <svg
        class="maxime-laurier"
        viewBox="14 32.1 172.1 151.3"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M102.23,163.96 A64,64 0 0 0 135.79,46.94" />
        <path d="M113.62,162.53 Q117.03,174.74 132.58,179.44 Q126.13,164.53 113.62,162.53" />
        <path d="M134.72,153.76 Q141.86,163.51 157.31,162.50 Q146.56,151.35 134.72,153.76" />
        <path d="M151.40,138.13 Q161.01,144.43 174.43,138.36 Q161.13,132.03 151.40,138.13" />
        <path d="M161.52,117.64 Q172.15,120.03 182.04,110.17 Q168.13,108.98 161.52,117.64" />
        <path d="M163.80,94.90 Q174.00,93.48 179.48,81.47 Q166.77,85.03 163.80,94.90" />
        <path d="M157.94,72.81 Q166.47,68.18 167.33,55.76 Q157.29,63.12 157.94,72.81" />
        <path d="M144.69,54.18 Q150.66,47.30 147.32,36.10 Q140.92,45.88 144.69,54.18" />
        <path d="M97.77,163.96 A64,64 0 0 1 64.21,46.94" />
        <path d="M86.38,162.53 Q73.87,164.53 67.42,179.44 Q82.97,174.74 86.38,162.53" />
        <path d="M65.28,153.76 Q53.44,151.35 42.69,162.50 Q58.14,163.51 65.28,153.76" />
        <path d="M48.60,138.13 Q38.87,132.03 25.57,138.36 Q38.99,144.43 48.60,138.13" />
        <path d="M38.48,117.64 Q31.87,108.98 17.96,110.17 Q27.85,120.03 38.48,117.64" />
        <path d="M36.20,94.90 Q33.23,85.03 20.52,81.47 Q26.00,93.48 36.20,94.90" />
        <path d="M42.06,72.81 Q42.71,63.12 32.67,55.76 Q33.53,68.18 42.06,72.81" />
        <path d="M55.31,54.18 Q59.08,45.88 52.68,36.10 Q49.34,47.30 55.31,54.18" />
      </svg>

      <blockquote class="maxime-texte">{`« ${maxim.text} »`}</blockquote>
      <figcaption class="maxime-sig">
        <span class="maxime-auteur">{maxim.author}</span>
        {maxim.source && <span class="maxime-source">{maxim.source}</span>}
      </figcaption>
    </figure>
  </div>
</section>
