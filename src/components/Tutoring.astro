---
import { profile } from '../data/profile';
import Catalogue from './Catalogue.astro';
import Avis from './Avis.astro';

const { tutoring } = profile;
---

<section class="section" id="tutorat">
  <div class="wrap">
    <div class="tutoring">
      {/* Filigrane : décoratif, donc masqué aux lecteurs d'écran — le nom de
          l'Académie est déjà annoncé juste en dessous, en toutes lettres. */}
      <span class="tutoring-grec" aria-hidden="true">{tutoring.greekName}</span>

      <div class="tutoring-intro">
        {/* « Tutorat » et non « Services de tutorat » : la section « Services
            offerts », juste au-dessus, dirait deux fois le même mot. */}
        <span class="eyebrow">Tutorat</span>
        <h2 class="tutoring-title">{tutoring.headline}</h2>
        {tutoring.description.map((p) => <p class="tutoring-desc">{p}</p>)}
      </div>

      <Catalogue />
      <Avis />

      <div class="tutoring-cta">
        <a class="btn btn-accent" href={tutoring.demandeUrl} target="_blank" rel="noopener">
          Faire une demande <span class="arrow">→</span>
        </a>
        <a class="btn btn-ghost" href={tutoring.avisUrl} target="_blank" rel="noopener">
          Laisser un avis
        </a>
        <span class="tutoring-note">{tutoring.ctaNote}</span>
      </div>
    </div>
  </div>
</section>
