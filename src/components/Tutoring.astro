---
import { profile } from '../data/profile';
import Avis from './Avis.astro';

const { tutoring } = profile;
---

<section class="section" id="tutorat">
  <div class="wrap">
    <div class="tutoring">
      <div>
        <span class="eyebrow">Services de tutorat</span>
        <h2 class="tutoring-title">{tutoring.headline}</h2>
        <p class="tutoring-desc">{tutoring.description}</p>
        <div class="subjects">
          {tutoring.subjects.map((s) => <span class="subject-chip">{s}</span>)}
        </div>
      </div>

      <div class="tutoring-cta">
        <a class="btn btn-accent" href={tutoring.demandeUrl} target="_blank" rel="noopener">
          Faire une demande de tutorat <span class="arrow">→</span>
        </a>
        <a class="btn btn-ghost" href={tutoring.avisUrl} target="_blank" rel="noopener">
          Laisser un avis
        </a>
        <span class="tutoring-note">{tutoring.ctaNote}</span>
      </div>
    </div>

    <Avis />
  </div>
</section>
