---
import { profile } from '../data/profile';

/* Les cinq sections, dans l'ordre de la page : une seule liste pour le menu
   d'ordinateur et pour la rangée du téléphone. */
const sections = [
  { href: '#services', label: 'Services' },
  { href: '#tutorat', label: 'Tutorat' },
  { href: '#projets', label: 'Projets' },
  { href: '#competences', label: 'Compétences' },
  { href: '#parcours', label: 'Parcours' },
];
---

<header class="site-nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top">
      <span class="mark">{profile.initials}</span>
      {profile.name}
    </a>
    <nav class="nav-links">
      <span class="nav-pastille" aria-hidden="true"></span>
      {sections.map((s) => <a class="nav-link" href={s.href}>{s.label}</a>)}
    </nav>
    <div class="nav-actions">
      <button
        class="theme-toggle"
        type="button"
        aria-label="Basculer entre le thème clair et sombre"
        title="Thème clair / sombre"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
      </button>
      <a class="btn btn-primary nav-cta" href="#contact">Me contacter</a>
    </div>
  </div>

  {/* Sur téléphone, les sections sur une seconde ligne de la même barre. En
      lisant vers le bas, la première ligne s'efface et seule cette rangée
      reste ; elle revient dès qu'on remonte. */}
  <nav class="nav-rangee" aria-label="Navigation principale">
    {sections.map((s) => <a href={s.href} data-onglet={s.href.slice(1)}>{s.label}</a>)}
  </nav>
</header>
